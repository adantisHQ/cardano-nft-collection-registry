{
  "name": "cardano-nft-collection-registry",
  "version": "0.1.1",
  "private": true,
  "description": "Collection Definition Registry for Cardano NFT metadata interpretation",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "validate-all": "pnpm --filter @cardano-nft-collection-registry/cli run start validate-all"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vite": "7.3.8"
  },
  "pnpm": {
    "overrides": {
      "tinypool": ">=2.1.2",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.23",
      "source-map-js": ">=1.2.2",
      "vite": "7.3.8",
      "esbuild": "0.28.1"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
